# --- Public web ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Native link association ---
# Apple Team ID used to build TEAMID.com.proofmode.app in apple-app-site-association.
APPLE_TEAM_ID=
# Comma-separated Android signing certificate SHA-256 fingerprints for com.proofmode.app.
ANDROID_APP_CERT_SHA256=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe legacy web subscription management ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PROOF_PLUS_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_CREATOR_PRICE_ID=

# --- RevenueCat monetization ---
# Exact Authorization header value configured on the RevenueCat webhook integration.
REVENUECAT_WEBHOOK_AUTH=
# HMAC signing secret shown when RevenueCat webhook signing is enabled.
REVENUECAT_WEBHOOK_SIGNING_SECRET=
# Secret server API key used only to fetch current Customer Info.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PROJECT_ID=
# Production RevenueCat Web Purchase Link templates without the App User ID path segment.
REVENUECAT_PROOF_PLUS_PURCHASE_URL=
REVENUECAT_CREATOR_PURCHASE_URL=

# --- Cloudflare media ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_BASE_URL=
CRON_SECRET=

# --- Analytics / observability ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=

# --- Rate limiting/cache ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Email ---
RESEND_API_KEY=
EMAIL_FROM=
